{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/dama",
      "destination": "/api/assistant?assistant=dama&mode=status"
    },
    {
      "source": "/api/vicky",
      "destination": "/api/assistant?assistant=vicky&mode=status"
    },
    {
      "source": "/api/ai/dama",
      "destination": "/api/assistant?assistant=dama&mode=ai"
    },
    {
      "source": "/api/ai/vicky/review-summary",
      "destination": "/api/assistant?assistant=vicky&mode=review"
    }
  ]
}
